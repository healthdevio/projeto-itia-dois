# Segredos. O .gitignore da raiz não cobre .env, e o Core passa a ler
# DATABASE_URL daqui (ver .env.example).
.env
.env.local

node_modules/
dist/

# Harness local de teste do Core — não versionado, de propósito.
#
# `local/` contém um servidor que substitui a AI (chama o backend da
# Nvidia), um REPL de TTY para exercitar os endpoints e um smoke test. É
# ferramenta de desenvolvimento de quem está mexendo no Core, não parte do
# produto: por isso fica fora do git, junto com a NVIDIA_API_KEY que o
# servidor precisa. Regra versionada, conteúdo não.
local/
