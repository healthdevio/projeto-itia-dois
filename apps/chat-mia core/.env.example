# Conexão com o Postgres que storeia as conversas.
# Ver docs/core/Conversation.md
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/omnia

# Porta do servidor do Core.
CORE_PORT=3001

# ---------------------------------------------------------------------------
# Mia AI
# ---------------------------------------------------------------------------
# A Mia AI roda dentro do Core, atrás da interface AIProvider. O Core não sabe
# qual modelo, provider ou prompt é usado: ele monta { message, context, config }
# e recebe { response, suggestions }. O config é o idioma, o tom e o tamanho que
# a interface pediu, e vai sem tradução. Ver docs/core/ChatConfig.md.
#
# Provider: nvidia (padrão) | echo (texto fixo, sem chamar modelo).
MIA_AI_PROVIDER=nvidia

# Chave do backend da Nvidia. Pegue em https://build.nvidia.com — a conta é free
# para os modelos de chat. Só é obrigatória com MIA_AI_PROVIDER=nvidia.
NVIDIA_API_KEY=

# Modelo de chat do NIM. Qualquer um da lista de build.nvidia.com serve.
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Base do NIM (compatível com a API da OpenAI).
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Teto de espera pelo modelo, em ms.
#
# Alto de propósito: a Nvidia devolve a resposta escrevendo token a token, e uma
# resposta longa passa dos 60 s sem que nada esteja errado. Com o teto curto, a
# requisição era cortada no meio da digitação e o usuário recebia um erro em vez
# da resposta que estava a caminho. Ainda é um teto: um provider pendurado vira
# erro em vez de vazar requisição para sempre.
NVIDIA_TIMEOUT_MS=300000

# Tokens máximos por resposta.
NVIDIA_MAX_TOKENS=400

# Ignora o `config` que o Core repassa (idioma, tom, tamanho) e responde sempre
# no padrão. Exercita o caminho de um provider que ainda não conhece o campo: a
# resposta sai no padrão, e o Core segue devolvendo o config que mandou.
# MIA_AI_IGNORE_CONFIG=1

# Não devolve o campo `suggestions`. Exercita o caminho em que a Mia AI ainda
# não sugere nada — as sugestões da interface devem sobreviver à resposta.
# MIA_AI_NO_SUGGESTIONS=1

# ---------------------------------------------------------------------------
# Sugestões
# ---------------------------------------------------------------------------
# Sugestão não tem variável própria: as que a Mia AI devolve na resposta são
# gravadas na conversa e lidas em GET /api/suggestions. Ver
# docs/core/Suggestion.md.
