# Conexão com o Postgres que storeia as conversas.
# Ver docs/core/Conversation.md
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/omnia

# Porta do servidor do Core.
CORE_PORT=3001

# ---------------------------------------------------------------------------
# Mia AI
# ---------------------------------------------------------------------------
# Endpoint do SERVIDOR da Mia AI (apps/packages/mia-ai) — não de um provider de
# IA. O Core não sabe qual modelo, provider ou prompt é usado: ele só manda
# { message, context, config } e recebe { response }. O config é o idioma, o tom
# e o tamanho que a interface pediu, e vai sem tradução. Ver
# docs/core/ChatConfig.md.
MIA_AI_ENDPOINT=http://localhost:3002/api/chat

# Autenticação da chamada entre serviços (Core → Mia AI). Não tem relação com a
# identidade do usuário, que vem de X-User-Id. O servidor da Mia AI decide se
# exige. Se preenchido, vai como `Authorization: Bearer`.
# MIA_AI_SERVICE_TOKEN=

# Tempo máximo de espera pela resposta da Mia AI.
# MIA_AI_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Sugestões
# ---------------------------------------------------------------------------
# Sugestão não tem variável própria: as que a Mia AI devolve na resposta são
# gravadas na conversa e lidas em GET /api/suggestions. Ver
# docs/core/Suggestion.md.
