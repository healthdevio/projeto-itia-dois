# Imagem do Core (apps/chat-core).
#
# Duas etapas: build compila o TS e leva o devDependencies inteiro; a final
# traz so dist/ e as dependencias de producao.
#
# As migrations vao na imagem porque o deploy as aplica num container separado,
# antes do Core subir. Sao .sql versionados, entao basta a pasta drizzle/.
#
# `entrypoint.sh` roda a migration antes do servidor HTTP. No compose isso era
# um servico a parte (migrate-core, restart: no). No Swarm todo servico e
# perpetual, entao um container de migration sairia com o Swarm recriando-o em
# laco -- e a migration nunca terminaria com o Core no ar.
#
# Para o Core nao subir enquanto o Postgres nao responde, o entrypoint espera o
# banco antes de aplicar: o Swarm nao implementa depends_on, entao quem espera
# por quem e a propria imagem.

FROM node:22-alpine AS build

WORKDIR /app

# O lockfile vem antes do codigo: a camada de dependencias so e invalidada
# quando a lista muda, nao a cada commit.
COPY apps/chat-core/package.json apps/chat-core/package-lock.json ./

RUN npm ci

COPY apps/chat-core/tsconfig.json ./
COPY apps/chat-core/src ./src

RUN npm run build

# ---------------------------------------------------------------------------

FROM node:22-alpine AS deps

WORKDIR /app

COPY apps/chat-core/package.json apps/chat-core/package-lock.json ./

RUN npm ci --omit=dev && npm cache clean --force

# ---------------------------------------------------------------------------

FROM node:22-alpine AS runtime

# wget vem no busybox do alpine e serve ao healthcheck.
WORKDIR /app

ENV NODE_ENV=production \
    CORE_PORT=3001

COPY --from=deps /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY apps/chat-core/drizzle ./drizzle
COPY apps/chat-core/package.json ./
COPY apps/docker/entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh

# O Core nao escreve em disco, entao roda sem root.
USER node

EXPOSE 3001

# Checar o codigo HTTP e nao o corpo: / responde "degraded" quando o Postgres
# cai, e derrubar o Core por causa do banco trocaria degradacao visivel por
# indisponibilidade total.
HEALTHCHECK --interval=15s --timeout=5s --start-period=90s --retries=5 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1:${CORE_PORT}/ || exit 1

ENTRYPOINT ["/bin/sh", "/entrypoint.sh"]