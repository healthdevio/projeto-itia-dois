FROM node:26-alpine AS build

WORKDIR /app

COPY apps/chat-back/package.json apps/chat-back/package-lock.json ./

RUN npm ci

COPY apps/chat-back/tsconfig.json ./
COPY apps/chat-back/src ./src

RUN npm run build

FROM node:26-alpine AS deps

WORKDIR /app

COPY apps/chat-back/package.json apps/chat-back/package-lock.json ./

RUN npm ci --omit=dev && npm cache clean --force

FROM node:26-alpine AS runtime

WORKDIR /app

# pg_isready vem do postgresql-client e serve ao entrypoint esperar o banco.
# Sem isso o entrypoint morre antes de tentar a conexao.
# O runtime nao usa npm; removemos o pacote global e seus executaveis da imagem.
RUN apk add --no-cache postgresql-client \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx

ENV NODE_ENV=production \
    CORE_PORT=80

COPY --from=deps /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY apps/chat-back/drizzle ./drizzle
COPY apps/chat-back/package.json ./
COPY apps/docker/entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh

USER node

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=5s --start-period=90s --retries=5 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1:${CORE_PORT}/health/live || exit 1

ENTRYPOINT ["/bin/sh", "/entrypoint.sh"]
