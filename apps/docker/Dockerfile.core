FROM node:22-alpine AS build

WORKDIR /app

COPY apps/chat-core/package.json apps/chat-core/package-lock.json ./

RUN npm ci

COPY apps/chat-core/tsconfig.json ./
COPY apps/chat-core/src ./src

RUN npm run build

FROM node:22-alpine AS deps

WORKDIR /app

COPY apps/chat-core/package.json apps/chat-core/package-lock.json ./

RUN npm ci --omit=dev && npm cache clean --force

FROM node:22-alpine AS runtime

WORKDIR /app

ENV NODE_ENV=production \
    CORE_PORT=3001

COPY --from=deps /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY apps/chat-core/drizzle ./drizzle
COPY apps/chat-core/package.json ./
COPY apps/docker/entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh

USER node

EXPOSE 3001

HEALTHCHECK --interval=15s --timeout=5s --start-period=90s --retries=5 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1:${CORE_PORT}/ || exit 1

ENTRYPOINT ["/bin/sh", "/entrypoint.sh"]