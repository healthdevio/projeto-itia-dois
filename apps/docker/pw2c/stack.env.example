# Copy these variable names into Portainer's stack environment and set secrets there.
OMNIA_CORE_IMAGE=registry.cloud.grupopw2c.com.br/chat-core:latest
OMNIA_WEB_IMAGE=registry.cloud.grupopw2c.com.br/chat-web:latest
OMNIA_WEB_PORT=8080

POSTGRES_DB=omnia
POSTGRES_USER=omnia_user
POSTGRES_PASSWORD=

AI_PROVIDER=echo
NVIDIA_API_KEY=
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_TENANT_CLAIM=tenant_id
CORS_ORIGINS=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT_MS=300000
NVIDIA_MAX_TOKENS=400
