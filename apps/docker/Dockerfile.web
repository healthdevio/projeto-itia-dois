# Imagem da interface (apps/chat-omnia): build do Vite, servido pelo nginx.
#
# O nginx também faz proxy de /api para o Core, o que coloca interface e API na
# mesma origem — sem CORS e sem URL do Core virando config do frontend.
#
# VITE_CORE_URL é ARG e não ENV de runtime: o Vite embute o valor no bundle
# durante a compilação.

FROM node:26-alpine AS build

WORKDIR /app

ARG VITE_CORE_URL=/api

ENV VITE_CORE_URL=$VITE_CORE_URL

COPY apps/chat-omnia/package.json apps/chat-omnia/package-lock.json ./

RUN npm ci

COPY apps/chat-omnia/ ./

RUN npm run build

# ---------------------------------------------------------------------------

FROM nginx:1.31.8-alpine3.24 AS runtime

RUN apk upgrade --no-cache

COPY apps/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

# nginx (uid 101) é dono dos arquivos para reescrever o cache sem root.
RUN chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx \
    && touch /var/run/nginx.pid \
    && chown nginx:nginx /var/run/nginx.pid

USER nginx

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=5 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1:8080/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
