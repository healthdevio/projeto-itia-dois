  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "embeddings/**/*.ts",
    "rag/**/*.ts",
    "vector-store/**/*.ts",
    "drizzle.config.ts"
  ]
}
